{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "problems",
    "instructions_for_claude",
    "applicable_sop_rule",
    "explicit_exclusions"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["scan_approved", "correct", "user_ruling_required"]
    },
    "summary": { "type": "string", "maxLength": 2000 },
    "problems": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "maxLength": 2000 }
    },
    "instructions_for_claude": { "type": "string", "maxLength": 8000 },
    "applicable_sop_rule": { "type": "string", "maxLength": 4000 },
    "explicit_exclusions": {
      "type": "array",
      "maxItems": 30,
      "items": { "type": "string", "maxLength": 2000 }
    }
  }
}
