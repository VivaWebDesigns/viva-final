MAILGUN_DOMAIN=mg.vivawebdesigns.com
MAILGUN_API_KEY=
MAILGUN_FROM_EMAIL=noreply@mg.vivawebdesigns.com

# Viva SAB Workflow connector. These credentials must belong to the business
# Google account; create_sab_workflow creates native Sheets in that Drive.
GOOGLE_OAUTH_CLIENT_JSON=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Stable secret used to create non-recipient-specific scan-report access links.
SCAN_REPORT_SHARE_SECRET=
# Dedicated Technical SEO scanner worker (optional tuning)
SCANNER_POLL_INTERVAL_MS=2000
